RewriteEngine On

# Forzar rutas dinámicas aunque exista la carpeta turnos en producción
RewriteRule ^turnos/?$ index.php [QSA,L]
RewriteRule ^turnos/(.*)$ index.php [QSA,L]
RewriteRule ^exclusivo/?$ index.php [QSA,L]
RewriteRule ^exclusivo/(.*)$ index.php [QSA,L]
RewriteRule ^api/(.*)$ index.php [QSA,L]

# Bloquear acceso a archivos sensibles
<FilesMatch "^(\.env|\.env\..*|config\.php|api-client\.php|\.git|composer\.(json|lock))$">
	Require all denied
</FilesMatch>

# Endurecimiento basico de respuestas
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]